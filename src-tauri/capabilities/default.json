{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "store:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/**/*"
        }
      ]
    }
  ]
}
